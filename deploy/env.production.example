# ============================================================================
# .env for the AWS EC2 server  ->  copy to  /var/www/tubtubon_ehealth/.env
#   sudo -u www-data cp deploy/env.production.example .env
#   sudo chmod 640 .env && sudo chown www-data:www-data .env
#
# This file contains PLACEHOLDERS ONLY. Never commit the real one.
# ============================================================================

APP_NAME="Tubtubon eHealth"
APP_ENV=production

# Leave BLANK. config/env.php auto-detects the base path from SCRIPT_NAME, so
# the same build works at http://IP/, https://ip.nip.io/ and https://yourdomain/
# with no edits. Only set this if you must pin it (e.g. "/ehealth" subdirectory).
APP_BASE_URL=""

# --- Database (local MySQL on the same instance; NOT RDS) -------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=tubtubon_ehealth
DB_USER=tubtubon
DB_PASS=CHANGE_ME_STRONG_PASSWORD

# --- Outbound SMS (keep the mock for the defense) ---------------------------
# PH SMS gateways cost real money and are not covered by AWS credits.
# "Semaphore Mock" is honest about being simulated. The other providers
# currently fall through to the simulator and fabricate "Delivered".
SMS_PROVIDER=Semaphore Mock
SMS_API_KEY=
SMS_SENDER_NAME=TUBTUBONHC

# --- Self-hosted Tesseract OCR (Phase 5 Sec. 1.8) ---------------------------
OCR_ENABLED=true
# Linux path after `apt install tesseract-ocr tesseract-ocr-eng`
TESSERACT_PATH=/usr/bin/tesseract
