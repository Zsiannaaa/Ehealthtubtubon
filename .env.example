APP_NAME="Tubtubon eHealth"
APP_ENV=local
APP_BASE_URL=""

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=tubtubon_ehealth
DB_USER=root
DB_PASS=

# Outbound SMS Gateway (Semaphore / iTexMo / MOVider / Simulated)
SMS_PROVIDER=Semaphore Mock
SMS_API_KEY=
SMS_SENDER_NAME=TUBTUBONHC

# Self-Hosted Tesseract OCR (Phase 5 Sec. 1.8)
# Windows default: "C:/Program Files/Tesseract-OCR/tesseract.exe"
# Linux/VPS default: /usr/bin/tesseract
# Leave blank to auto-detect; set OCR_ENABLED=false to force manual encoding (FR-27).
OCR_ENABLED=true
TESSERACT_PATH=
